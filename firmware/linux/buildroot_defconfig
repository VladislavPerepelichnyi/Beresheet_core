#
# Buildroot configuration for the Beresheet SoC.
#
#   cd $BUILDROOT
#   make defconfig BR2_DEFCONFIG=<this file>
#   make
#
# ISA: rv32ima with no C extension and no FPU, so ABI ilp32. A userspace built
# with compressed instructions faults on the first one.
#
# Memory: 8 MiB in total, shared with the kernel, so the rootfs is a gzipped
# cpio unpacked into RAM, and the C library is musl, whose static binaries are
# a fraction of the size of glibc's. Changing the C library rebuilds the whole
# toolchain.
#

BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVI=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
# BR2_RISCV_ISA_RVC deliberately not set.
BR2_RISCV_32=y
BR2_RISCV_ABI_ILP32=y
BR2_RISCV_USE_MMU=y

BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=n

BR2_OPTIMIZE_S=y
BR2_STATIC_LIBS=y

# --- kernel ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.9"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="@TOPDIR@/firmware/linux/linux.config"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=n

# With a custom kernel version, Buildroot cannot infer the kernel headers
# series and its headers check fails late in the build ("expected 2.6.x, got
# 6.9.x"). State the series explicitly.
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_9=y

# --- userspace: as little as will still boot ---
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="@TOPDIR@/firmware/linux/busybox.fragment"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y
BR2_TARGET_GENERIC_HOSTNAME="custom-riscv"
BR2_TARGET_GENERIC_ISSUE="Linux on a hand-written RV32IMA core"

# --- rootfs: a gzipped cpio, loaded into RAM by the BIOS ---
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_EXT2=n
BR2_TARGET_ROOTFS_TAR=n

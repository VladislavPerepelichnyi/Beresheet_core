# Read by /bin/sh because inittab starts it as a login shell.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export TERM=vt100

# The board has no clock to read at boot, so the epoch starts at zero and every
# timestamp is nonsense until you set it by hand. Saying so once is kinder than
# letting `ls -l` imply the files are from 1970.
export PS1='custom-riscv:\w # '

echo "profile: shell is up, this line came via the tty" > /dev/kmsg
echo ""
echo "Linux $(uname -r) on a hand-written RV32IMA core."
# free's own output, not piped through awk - the BusyBox fragment turns AWK off
# as a luxury this machine cannot afford, and this line was calling it anyway.
free
echo ""
echo "/proc is mounted. For /dev, /sys and /tmp: /etc/init.d/mountall"
echo ""

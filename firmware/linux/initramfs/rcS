#!/bin/sh
#
# Run once by init (see inittab) before the shell starts.
#
# echo is an ash builtin and costs nothing; every other command is a fork and
# exec of the static BusyBox binary, which takes seconds on this machine. So
# rcS mounts only /proc, which free, ps, top and uptime need, and prints a
# kernel log line before each step so a slow boot can be told from a hung one.
# /dev, /sys and /tmp are left to /etc/init.d/mountall:
#   /dev   the initramfs already provides console, null, tty and ttyS0
#   /sys   nothing in the applet set reads it
#   /tmp   the rootfs is already a writable RAM filesystem

echo "rcS: mounting /proc" > /dev/kmsg
mount -t proc proc /proc

echo "rcS: setting hostname" > /dev/kmsg
# The hostname applet is disabled in busybox.fragment; this is the same
# syscall without a fork.
echo custom-riscv > /proc/sys/kernel/hostname

echo "rcS: done, starting shell" > /dev/kmsg

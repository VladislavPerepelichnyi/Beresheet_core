#
# BusyBox trimmings for an 8 MiB machine.
#
# Everything here is off because it cannot work or cannot fit, not to be
# minimal for its own sake. Applets that talk to hardware this SoC does not
# have are the bulk of it.
#
CONFIG_STATIC=y

# No network interface exists on this board.
# CONFIG_UDHCPC is not set
# CONFIG_UDHCPD is not set
# CONFIG_IFCONFIG is not set
# CONFIG_IP is not set
# CONFIG_PING is not set
# CONFIG_WGET is not set
# CONFIG_TELNETD is not set

# No block devices, so nothing to format, check or mount from one.
# CONFIG_FDISK is not set
# CONFIG_MKFS_EXT2 is not set
# CONFIG_FSCK is not set
# CONFIG_MKSWAP is not set
# CONFIG_SWAPON is not set

# Editors and pagers are luxuries at this size.
# CONFIG_VI is not set
# CONFIG_AWK is not set
# CONFIG_LESS is not set
# CONFIG_MAN is not set

# Keep: sh, mount, ls, cat, echo, dmesg, free, ps, uname, init.
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_INIT=y
CONFIG_MOUNT=y
CONFIG_DMESG=y
CONFIG_FREE=y
CONFIG_PS=y
CONFIG_UNAME=y

# -----------------------------------------------------------------------------
# Everything below was added when the userspace moved from a single test binary
# to a real BusyBox. An initramfs is unpacked into a ramfs that is never
# reclaimed, so the *uncompressed* size of this binary is permanent RAM out of
# the 3440 KiB the kernel leaves free. Every applet here is either impossible on
# this hardware or not worth its bytes.
# -----------------------------------------------------------------------------

# tc does not compile at all against current kernel headers: BusyBox 1.37 still
# references the CBQ qdisc, which Linux deleted from pkt_sched.h. It is a
# traffic shaper on a board with no network interface, so this is a free fix.
# CONFIG_TC is not set

# The rest of the networking stack, for the same reason as the applets above:
# there is no interface for any of it to bind to.
# CONFIG_ARP is not set
# CONFIG_ARPING is not set
# CONFIG_BRCTL is not set
# CONFIG_FTPGET is not set
# CONFIG_FTPPUT is not set
# CONFIG_HOSTNAME is not set
# CONFIG_HTTPD is not set
# CONFIG_IFPLUGD is not set
# CONFIG_IFUP is not set
# CONFIG_IFDOWN is not set
# CONFIG_INETD is not set
# CONFIG_IPCALC is not set
# CONFIG_NAMEIF is not set
# CONFIG_NBDCLIENT is not set
# CONFIG_NC is not set
# CONFIG_NETSTAT is not set
# CONFIG_NSLOOKUP is not set
# CONFIG_NTPD is not set
# CONFIG_ROUTE is not set
# CONFIG_SLATTACH is not set
# CONFIG_SSL_CLIENT is not set
# CONFIG_TCPSVD is not set
# CONFIG_TELNET is not set
# CONFIG_TFTP is not set
# CONFIG_TRACEROUTE is not set
# CONFIG_TUNCTL is not set
# CONFIG_UDPSVD is not set
# CONFIG_VCONFIG is not set
# CONFIG_ZCIP is not set

# CONFIG_MODULES is off in the kernel config, so there is nothing to load,
# unload or list, and no /lib/modules for these to read.
# CONFIG_INSMOD is not set
# CONFIG_RMMOD is not set
# CONFIG_LSMOD is not set
# CONFIG_MODPROBE is not set
# CONFIG_DEPMOD is not set
# CONFIG_MODINFO is not set

# devtmpfs is mounted by rcS and populates /dev from what the kernel actually
# registered. mdev would be a second, worse implementation of that.
# CONFIG_MDEV is not set

# The kernel ring buffer is readable with dmesg. Running a syslog daemon to copy
# it into a file on a tmpfs, in RAM, next to the buffer it came from, is paying
# twice for one copy.
# CONFIG_SYSLOGD is not set
# CONFIG_KLOGD is not set
# CONFIG_LOGGER is not set
# CONFIG_LOGREAD is not set

# One shell is enough, and inittab names ash.
# CONFIG_HUSH is not set
# CONFIG_SHELL_HUSH is not set

# No block devices and no removable media: nothing to partition, label, spin
# down or eject.
# CONFIG_BLKID is not set
# CONFIG_BLOCKDEV is not set
# CONFIG_EJECT is not set
# CONFIG_HDPARM is not set
# CONFIG_LOSETUP is not set
# CONFIG_MKE2FS is not set
# CONFIG_TUNE2FS is not set
# CONFIG_E2FSCK is not set
# CONFIG_FSCK_MINIX is not set
# CONFIG_MKFS_MINIX is not set
# CONFIG_MKFS_VFAT is not set
# CONFIG_FATATTR is not set
# CONFIG_UBIATTACH is not set
# CONFIG_UBIDETACH is not set

# No framebuffer, no keyboard, no virtual terminals - CONFIG_VT is not set in
# the kernel, so /dev/tty1 does not exist.
# CONFIG_FBSET is not set
# CONFIG_FBSPLASH is not set
# CONFIG_SETCONSOLE is not set
# CONFIG_OPENVT is not set
# CONFIG_CHVT is not set
# CONFIG_DEALLOCVT is not set
# CONFIG_LOADFONT is not set
# CONFIG_LOADKMAP is not set
# CONFIG_SETKEYCODES is not set
# CONFIG_KBD_MODE is not set
# CONFIG_SHOWKEY is not set

# Login, passwords and multiple users on a board whose console is a UART with no
# access control. inittab starts the shell directly; see the comment there.
# CONFIG_LOGIN is not set
# CONFIG_PASSWD is not set
# CONFIG_SU is not set
# CONFIG_SULOGIN is not set
# CONFIG_ADDUSER is not set
# CONFIG_DELUSER is not set
# CONFIG_ADDGROUP is not set
# CONFIG_DELGROUP is not set
# CONFIG_GETTY is not set
# CONFIG_CRYPTPW is not set
# CONFIG_CHPASSWD is not set

# Compressors. gzip stays because the initramfs is one and being able to read it
# back on the target is worth 8 KiB; the rest are a different format each.
# CONFIG_BZIP2 is not set
# CONFIG_LZOP is not set
# CONFIG_XZ is not set
# CONFIG_UNXZ is not set
# CONFIG_UNLZMA is not set
# CONFIG_LZMA is not set
# CONFIG_BUNZIP2 is not set
# CONFIG_RPM is not set
# CONFIG_RPM2CPIO is not set
# CONFIG_DPKG is not set
# CONFIG_DPKG_DEB is not set

# BusyBox 1.37 offers x86 SHA-NI acceleration and guards it on the *host*, not
# the target, so a cross-build for anything else fails in libbb:
#
#   hash_md5_sha.c:1316: 'sha1_process_block64_shaNI' undeclared
#
# The assembly files are unconditionally assembled and the C reference to them
# is unconditionally emitted; on riscv32 the former produce nothing. There is no
# RISC-V equivalent to fall back to, so plain C it is.
# CONFIG_SHA1_HWACCEL is not set
# CONFIG_SHA256_HWACCEL is not set

# --- musl-specific, and all useless on this board anyway ---------------------
#
# hwclock does not compile against musl on a 32-bit target:
#
#   hwclock.c:143: 'SYS_settimeofday' undeclared
#
# musl on rv32 uses 64-bit time_t, so the kernel only offers
# SYS_settimeofday_time32 and musl deliberately does not define the bare name.
# glibc papers over this; musl does not. It is moot regardless - this board has
# no RTC at all, which is why the epoch starts at zero on every boot.
# CONFIG_HWCLOCK is not set
# CONFIG_RTCWAKE is not set

# Network filesystems, for the same reason as the rest of the networking group.
# CONFIG_FEATURE_MOUNT_NFS is not set
# CONFIG_FEATURE_MOUNT_CIFS is not set
# CONFIG_RDATE is not set

`ifndef WB_DEFINES_VH
`define WB_DEFINES_VH

// =============================================================================
// Wishbone B4 bus parameters and the SoC memory map.
//
// Signal names and semantics follow doc/bus/wbspec_b4.pdf, sections 2.2.3
// (MASTER signals) and 2.2.4 (SLAVE signals). We implement the "classic
// standard" single read/write cycle from section 3.2.1 / 3.2.3: one STB per
// transfer, terminated by ACK or ERR. No block cycles, no tags, no pipelining.
//
// One detail from the spec worth stating: on a 32-bit port with byte
// granularity the address array is ADR_O(n..2) - the low two bits are NOT on
// the bus. Byte lanes are selected by SEL_O instead. Our core already produces
// a word-aligned address plus a byte strobe, so that maps across directly.
// =============================================================================

// ---------------------------------------------------------------------------
// SoC clock.
//
// One number, because it is coupled to more than it looks: the CLINT divides it
// to make mtime tick at 1 MHz, the SDRAM controller derives its refresh interval
// and power-up delays from it, and the UART divisor is computed from it in
// firmware. 24 MHz divides evenly by 1 MHz, which keeps mtime counting whole
// microseconds and keeps `timebase-frequency` in the device tree honest - 27 or
// 23.625 would not.
//
// Three things outside this file have to agree and cannot read it:
//
//   RTL/fpga/tang_nano_20k/gowin_rpll.v      the PLL dividers
//   RTL/fpga/tang_nano_20k/tang_nano_20k.sdc the clock period
//   firmware/bios/soc.h                      CPU_HZ, for the UART divisor
//
// and the device tree's clock-frequency, which the Makefile does not generate.
// ---------------------------------------------------------------------------
// Generated by the Makefile into build/fpga, which is on the synthesis include
// path. The Gowin flow has no -verilog_define option, so a generated header is
// the only way to get a build-time switch into the RTL.
`include "clk_config.vh"

// CLK18 selects the 18 MHz PLL setting in gowin_rpll.v; see the comment there
// for why that experiment exists. Everything derived from the clock - the CLINT
// divider, the UART divisor, timebase-frequency in the device tree - follows
// this one define, so the two can never disagree.
`ifdef CLK18
`define SOC_CLK_HZ 18_000_000
`else
`define SOC_CLK_HZ 24_000_000
`endif

`define WB_DATA_WIDTH 32
`define WB_ADDR_WIDTH 32          // full byte address; bits 1:0 are always zero
`define WB_SEL_WIDTH  4

// ---------------------------------------------------------------------------
// Memory map.
//
// Decoded on addr[31:24], so each region is a single 8-bit compare and the
// conventional RISC-V addresses can be used as-is. The base addresses are ours
// to choose - software learns them from the device tree - but the *offsets
// inside* the CLINT are fixed by the ACLINT specification, and those are what
// existing drivers depend on.
//
//   0x0000_0000  boot RAM, 32 KB   reset vector
//   0x0200_0000  CLINT             conventional address, ACLINT layout
//   0x0C00_0000  PLIC              conventional address, PLIC register layout
//   0x1000_0000  UART 16550
//   0x1100_0000  LED PWM           our own device, see led_pwm_wb.v
//   0x1200_0000  SD card, SPI mode  ZipCPU's sdspi behind a bus adapter
//   0x8000_0000  SDRAM, 8 MB
//
// Like the CLINT, the PLIC's base is a convention while its internal offsets
// are specified. It needs 4 MB of space because the per-context blocks are
// 4 KB apart starting at +0x200000; a 16 MB region covers that comfortably.
// ---------------------------------------------------------------------------
`define REGION_SEL(a) (a[31:24])

`define REGION_BOOT  8'h00
`define REGION_CLINT 8'h02
`define REGION_PLIC  8'h0C
`define REGION_UART  8'h10
`define REGION_LED   8'h11
`define REGION_SD    8'h12
`define REGION_SDRAM 8'h80

// The full base address of each region, for code that needs the address rather
// than the decode nibble - a linker script value, or a simulation preload.
`define SDRAM_BASE_ADDR 32'h8000_0000

// Region sizes actually decoded inside each slave
`define BOOT_RAM_BYTES  32768     // 32 KB of block RAM
`define SDRAM_BYTES     8388608   // 8 MB, GW2AR-18 embedded 64 Mbit
`define UART_REG_BYTES  32        // 8 registers, byte addressed
`define CLINT_BYTES     65536     // 0x0000..0xBFF8 used
`define LED_CHANNELS    6

// PLIC geometry. Sources are numbered from 1; source 0 does not exist, so
// PLIC_SRCS = 8 gives seven usable interrupt lines. Two contexts: hart 0
// machine mode, and hart 0 supervisor mode reserved for when S-mode lands.
`define PLIC_SRCS       8
`define PLIC_CTXS       2
`define PLIC_MAX_PRIO   7

// Which source each device is wired to. These numbers are what firmware and a
// device tree have to agree on.
`define PLIC_SRC_UART   1
`define PLIC_SRC_SW0    2         // software-triggered lines, see led_pwm_wb.v
`define PLIC_SW_LINES   4
`define PLIC_SRC_SD     6

`endif

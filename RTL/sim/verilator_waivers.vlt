`verilator_config

// =============================================================================
// Lint waivers. The project RTL is linted with -Wall; each waiver below is
// scoped as narrowly as possible and states why it is acceptable.
// =============================================================================

// --- Testbenches and behavioural models -------------------------------------
// Testbenches and simulation models use blocking assignments in clocked
// blocks, and sample synchronously a reset driven from an initial block.
lint_off -rule BLKSEQ          -file "*/tb_soc.v"
lint_off -rule BLKSEQ          -file "*/sdram_model.v"
lint_off -rule BLKSEQ          -file "*/sd_model.v"
lint_off -rule BLKSEQ          -file "*/tb_plic.v"
lint_off -rule BLKSEQ          -file "*/tb_dcache.v"
lint_off -rule BLKSEQ          -file "*/tb_mmu.v"
lint_off -rule SYNCASYNCNET    -file "*/tb_soc.v"
lint_off -rule SYNCASYNCNET    -file "*/tb_plic.v"
lint_off -rule SYNCASYNCNET    -file "*/tb_dcache.v"
lint_off -rule SYNCASYNCNET    -file "*/tb_mmu.v"
lint_off -rule UNUSEDSIGNAL    -file "*/tb_dcache.v"
lint_off -rule UNUSEDSIGNAL    -file "*/tb_mmu.v"

// --- Deliberately unused instruction and address slices ---------------------
// The immediate generator does not use the opcode field.
lint_off -rule UNUSEDSIGNAL -file "*/imm_gen.v"      -match "*inst*"
// BTB indexing ignores the two always-zero PC bits.
lint_off -rule UNUSEDSIGNAL -file "*/pc_gen.v"       -match "*branch_pc*"
// Sub-word load extraction keeps only the low lane of the shifted word.
lint_off -rule UNUSEDSIGNAL -file "*/mem_wb.v"       -match "*rdata_shifted*"
// mepc/sepc hold aligned addresses; the low bits of the trap PC are dropped.
lint_off -rule UNUSEDSIGNAL -file "*/CSR_unit.v"     -match "*trap_epc*"

// --- Third-party and derived peripheral code ---------------------------------
// uart16550 (OpenCores) and sdram_core.v (nand2mario) are kept close to
// upstream so a diff shows only local changes; their style warnings are
// waived rather than fixed. Some sdram_core.v warnings (WIDTHEXPAND, CASEX,
// CASEINCOMPLETE) are reported before the file waiver applies and remain
// visible; they are present upstream and benign at the widths used.
lint_off -rule ASSIGNDLY       -file "*/uart16550/*"
lint_off -rule WIDTHTRUNC      -file "*/uart16550/*"
lint_off -rule WIDTHEXPAND     -file "*/uart16550/*"
lint_off -rule IMPLICIT        -file "*/uart16550/*"
lint_off -rule CASEX           -file "*/uart16550/*"
lint_off -rule CASEINCOMPLETE  -file "*/uart16550/*"
lint_off -rule ASSIGNDLY       -file "*/sdram_core.v"
lint_off -rule WIDTHTRUNC      -file "*/sdram_core.v"
lint_off -rule WIDTHEXPAND     -file "*/sdram_core.v"
lint_off -rule IMPLICIT        -file "*/sdram_core.v"
lint_off -rule CASEX           -file "*/sdram_core.v"
lint_off -rule CASEINCOMPLETE  -file "*/sdram_core.v"

// uart16550 declares a `timescale and most project modules do not; nothing in
// the design depends on time resolution.
lint_off -rule TIMESCALEMOD

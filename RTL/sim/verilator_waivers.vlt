`verilator_config

// Lint waivers for this project.
//
// The RTL is linted with -Wall. Everything waived below is either normal
// testbench style or a bit slice that is genuinely unused at this stage of the
// roadmap. Each entry says why.

// --- Testbench style -------------------------------------------------------
// A behavioural clock generator and plain integer counters are the point of a
// testbench, not a synthesis concern.
lint_off -rule BLKSEQ        -file "*/tb_rv32i.v"
lint_off -rule BLKSEQ        -file "*/tb_plic.v"
lint_off -rule BLKSEQ        -file "*/tb_dcache.v"
lint_off -rule BLKSEQ        -file "*/tb_mmu.v"
lint_off -rule UNUSEDSIGNAL  -file "*/tb_mmu.v"
lint_off -rule SYNCASYNCNET  -file "*/tb_mmu.v"
lint_off -rule PINCONNECTEMPTY -file "*/soc_sim.v"
lint_off -rule UNUSEDSIGNAL  -file "*/tb_dcache.v"
// Reset is driven by an initial block and consumed by both async resets in the
// design and sync sampling in the checkers. Expected.
lint_off -rule SYNCASYNCNET  -file "*/tb_rv32i.v"
lint_off -rule SYNCASYNCNET  -file "*/tb_plic.v"
lint_off -rule SYNCASYNCNET  -file "*/tb_dcache.v"

// --- Deliberately unused instruction / address slices ----------------------
// The control unit decodes opcode, funct3, funct7 and funct12; the register
// fields belong to the datapath.
lint_off -rule UNUSEDSIGNAL -file "*/control_unit.v" -match "*instruction*"
// Alignment checking only looks at the low address bits.
lint_off -rule UNUSEDSIGNAL -file "*/control_unit.v" -match "*mem_addr*"
// The immediate generator never looks at the opcode field.
lint_off -rule UNUSEDSIGNAL -file "*/imm_gen.v"      -match "*inst*"
// BTB indexing ignores the two always-zero low PC bits.
lint_off -rule UNUSEDSIGNAL -file "*/pc_gen.v"       -match "*branch_pc*"
// Sub-word load extraction shifts the word down and keeps the low lane.
lint_off -rule UNUSEDSIGNAL -file "*/mem_wb.v"       -match "*rdata_shifted*"

// --- Vendored and derived peripheral code ----------------------------------
// Two files here are not ours to reformat:
//
//   uart16550/*      OpenCores IP, 2005-vintage Verilog. Silicon-proven, and
//                    kept byte-identical to upstream apart from one `define so
//                    that `diff` against the reference tree stays meaningful.
//   sdram_core.v     nand2mario's controller, carrying exactly one functional
//                    change (the masked word write). Same reasoning: the value
//                    of the file is that a diff shows only that change.
//
// Their style warnings are therefore waived rather than fixed. The core and the
// bus - the code we actually own - are linted at -Wall with no waivers beyond
// the documented slices above, and `make lint` enforces that.
lint_off -rule ASSIGNDLY       -file "RTL/peripherals/uart16550/*"
lint_off -rule WIDTHTRUNC      -file "RTL/peripherals/uart16550/*"
lint_off -rule WIDTHEXPAND     -file "RTL/peripherals/uart16550/*"
lint_off -rule IMPLICIT        -file "RTL/peripherals/uart16550/*"
lint_off -rule CASEX           -file "RTL/peripherals/uart16550/*"
lint_off -rule CASEINCOMPLETE  -file "RTL/peripherals/uart16550/*"
// Note: these five do NOT currently take effect - Verilator emits them from
// sdram_core.v before the file-scoped waiver applies, and they survive:
//   WIDTHEXPAND x3   two 9-bit replicates into 10-bit targets, and a 15-bit
//                    reset counter compared against a 25-bit constant
//   CASEX, CASEINCOMPLETE   the controller's casex over {state, cycle}
// All five are present in nand2mario's original and are benign: the replicates
// and the counter comparison are correct at the widths used, and the casex arms
// that are not listed intentionally fall through and hold inside a clocked
// block. They are left visible rather than chased, because the point of this
// file is to stay diffable against upstream. `make lint` covers the code we own
// and is clean.
lint_off -rule ASSIGNDLY       -file "*sdram_core.v"
lint_off -rule WIDTHTRUNC      -file "*sdram_core.v"
lint_off -rule WIDTHEXPAND     -file "*sdram_core.v"
lint_off -rule IMPLICIT        -file "*sdram_core.v"
lint_off -rule CASEX           -file "*sdram_core.v"
lint_off -rule CASEINCOMPLETE  -file "*sdram_core.v"

// TIMESCALEMOD is project-wide rather than file-scoped: the vendored UART ships
// its own `timescale.v`, which makes Verilator flag every module that does not
// declare one - i.e. all of ours. Adding a timescale to fourteen core files to
// silence a mixed-vintage import is the wrong trade; nothing here depends on
// simulation time resolution.
lint_off -rule TIMESCALEMOD

// --- Trap plumbing: intentionally partial slices ---------------------------
// mip and mie are 32 bits wide by definition, but only three bits are defined
// for machine mode (MSI 3, MTI 7, MEI 11). The rest are reserved and read zero.
lint_off -rule UNUSEDSIGNAL -file "*/control_unit.v" -match "*mip_and_mie*"
// mepc holds only legal instruction addresses, so the low two bits are dropped
// on the way in rather than stored.
lint_off -rule UNUSEDSIGNAL -file "*/CSR_unit.v" -match "*trap_epc*"

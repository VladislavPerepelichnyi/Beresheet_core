// =============================================================================
// Pin constraints, Tang Nano 20K (GW2AR-LV18QN88C8/I7).
//
// The in-package SDRAM has no entries: its O_sdram_* / IO_sdram_dq ports are
// placed by the Gowin toolchain.
// =============================================================================

// --- 27 MHz crystal ---
IO_LOC  "sys_clk" 4;
IO_PORT "sys_clk" PULL_MODE=UP IO_TYPE=LVCMOS33;

// --- S1 button, currently unused by the design ---
IO_LOC  "s1" 88;
IO_PORT "s1" PULL_MODE=UP IO_TYPE=LVCMOS33;

// --- UART, through the on-board USB bridge (its second serial interface) ---
IO_LOC  "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- Six on-board LEDs, active low ---
IO_LOC  "led[0]" 15;
IO_PORT "led[0]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[2]" 17;
IO_PORT "led[2]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[3]" 18;
IO_PORT "led[3]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[4]" 19;
IO_PORT "led[4]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[5]" 20;
IO_PORT "led[5]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// --- microSD socket in SPI mode: DAT3 = CS, CMD = MOSI, CLK = SCK,
//     DAT0 = MISO. No card-detect pin. The pull-ups keep MISO and CS at
//     their idle-high level while the card is not driving them.
IO_LOC  "sd_cs_n" 81;
IO_PORT "sd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_mosi" 82;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_sck" 83;
IO_PORT "sd_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_miso" 84;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

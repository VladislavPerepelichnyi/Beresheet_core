// =============================================================================
// Physical constraints for Tang Nano 20K (GW2AR-LV18QN88C8/I7).
//
// The in-package SDRAM is deliberately absent: its ports use the O_sdram_* /
// IO_sdram_dq names that the Gowin toolchain places automatically. Constraining
// them by hand would fight the tool.
// =============================================================================

// --- 27 MHz crystal ---
IO_LOC  "sys_clk" 4;
IO_PORT "sys_clk" PULL_MODE=UP IO_TYPE=LVCMOS33;

// --- S1 button, used as a manual reset. Pressed pulls the pin low, so the
//     pull-up matters: without it the pin floats and the design may sit in
//     reset or reset at random.
IO_LOC  "s1" 88;
IO_PORT "s1" PULL_MODE=UP IO_TYPE=LVCMOS33;

// --- Serial, through the on-board USB bridge (the second /dev/ttyUSB*) ---
IO_LOC  "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- Six on-board LEDs, active low ---
IO_LOC  "led[0]" 15;
IO_PORT "led[0]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[2]" 17;
IO_PORT "led[2]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[3]" 18;
IO_PORT "led[3]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[4]" 19;
IO_PORT "led[4]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[5]" 20;
IO_PORT "led[5]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// --- microSD socket, used in SPI mode.
//
// The socket's four data lines are wired for one-bit SPI rather than the
// four-bit SD protocol: DAT0 is MISO, CMD is MOSI, and DAT3 doubles as chip
// select, which is what a card expects when it is held low at power-up.
//
// There is no card-detect pin on this board, so the controller is told the card
// is always present and relies on the card itself to report a removal.
//
// Pull-ups matter here. An SD card idles its lines high, and a floating MISO
// during the 74 idle clocks before CMD0 is read as data - which shows up as a
// card that never leaves idle.
IO_LOC  "sd_cs_n" 81;
IO_PORT "sd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_mosi" 82;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_sck" 83;
IO_PORT "sd_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_miso" 84;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
